# ==============================================================================
# hack2win .gitignore — 生产级开源项目通用忽略规则
# ==============================================================================

# --- 操作系统缓存与元数据 ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- 编辑器与 IDE 配置 ---
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
*.bak

# --- 密钥、凭据与敏感环境变量 ---
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.cert
*.crt
id_rsa*
*.p12
*.pfx

# --- Node.js / 前端产物 ---
node_modules/
.next/
dist/
build/
out/
.turbo/
.cache/
.parcel-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache

# --- Python / 虚拟环境与字节码 ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# --- 本地数据库与运行时临时文件 ---
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log
.run/
*.pid
_dom_check.html
_uitest/
tmp/
temp/
*.tmp
